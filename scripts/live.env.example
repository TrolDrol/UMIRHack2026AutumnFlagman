# Copy to private scripts/live.env (git ignored). Never use real credentials here.
RIMS_DB_PASSWORD=replace-with-local-random-password
RIMS_ENVIRONMENT=Development
RIMS_FRONTEND_PORT=3288
RIMS_PUBLIC_ORIGIN=http://localhost:3288
# Override these together if the default subnet overlaps another Docker project.
RIMS_APPLICATION_SUBNET=172.30.82.0/24
RIMS_GATEWAY_IP=172.30.82.10
RIMS_BACKEND_IMAGE=rims-backend:local
RIMS_FRONTEND_IMAGE=rims-frontend:local-live
RIMS_CUSTOMER_FRONTEND_IMAGE=rims-customer:local-live
RIMS_SUPPLIER_FRONTEND_IMAGE=rims-supplier:local-live
# Optional external-muted notification profile (default launch stays muted).
# Password: grafana/secrets/smtp_password; bot: grafana/secrets/live_telegram_bot_token.
# GF_SMTP_ENABLED=true
# GF_SMTP_HOST=smtp.yandex.ru:587
# GF_SMTP_USER=YOUR_MAILBOX
# GF_SMTP_FROM_ADDRESS=YOUR_MAILBOX
# GF_SMTP_SKIP_VERIFY=false
# GF_SMTP_STARTTLS_POLICY=MandatoryStartTLS
# LIVE_TELEGRAM_CHAT_ID=YOUR_CHAT_ID
# LIVE_ALERT_EMAIL_ADDRESSES=YOUR_RECIPIENT
# TECHNICAL_ALERT_EMAIL_ADDRESSES=YOUR_TECHNICAL_RECIPIENT
# Optional if Telegram IPv4 is unavailable but the server has working IPv6:
# RIMS_NOTIFICATION_IPV6=true
# RIMS_TELEGRAM_API_IPV6=VERIFIED_CURRENT_TELEGRAM_AAAA
