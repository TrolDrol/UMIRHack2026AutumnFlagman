# Only project roots belong in the repository; new root files need an explicit entry.
/*
!/.gitignore
!/.dockerignore
!/README.md
!/.github/
!/backend/
!/frontend/
!/customer_frontend/
!/supplier_frontend/
!/packages/
!/scripts/
!/integration/
!/grafana/

# Dependencies, generated build output and local tooling
node_modules/
[Bb]in/
[Oo]bj/
dist/
dist-demo/
coverage/
.npm-cache/
.vite/
.vs/
.vscode/
.idea/
__pycache__/
*.py[cod]
*.tsbuildinfo
*.user
*.suo
*.log
.DS_Store
Thumbs.db

# Private configuration, credentials and database files
.env
.env.local
.env.*.local
*.env
!*.env.example
.keys/
secrets/
*.pem
*.pfx
*.key
*.dump
*.bak
.test-postgres*/
.tools/

# Generated evidence, downloads, reports and recordings
.artifacts/
artifacts/
test-results/
playwright-report/
blob-report/
*.trx
*.pptx
*.ppt
*.pdf

/docs/
*.md
!/README.md

# Local stack
/scripts/*
!/scripts/live.ps1
!/scripts/live.env.example
!/scripts/compose.live.yml
!/scripts/compose.staging.yml
!/scripts/compose.monitoring.yml
!/scripts/compose.notifications.external.yml
!/scripts/compose.notifications.ipv6.yml
!/scripts/runtime/
/scripts/runtime/*
!/scripts/runtime/nginx.live.conf

# Keep portable integration checks used by CI; exclude one-off server mutations/seeds
/integration/*
!/integration/gateway.mjs
!/integration/live-browser.mjs
!/integration/verify-runtime-replacement.mjs
!/integration/verify-persistence.mjs
!/integration/verify-live-metrics.mjs
!/integration/verify-db-unavailable.mjs
!/integration/availability-websocket.mjs

# Monitoring
/grafana/compose*.yml
/grafana/versions.env
/grafana/.env.example
/grafana/mock-metrics/
/grafana/nginx/
/grafana/prometheus/
/grafana/runtime/
/grafana/grafana/dashboards/
/grafana/grafana/provisioning/alerting/
/grafana/scripts/*
!/grafana/scripts/generate.py
!/grafana/scripts/prepare-live.py
!/grafana/scripts/configure-notifications.py
!/grafana/scripts/init-local.ps1
!/grafana/scripts/smoke.py
!/grafana/scripts/preflight-providers.py
!/grafana/scripts/verify-muted-live.py
/grafana/tests/*
!/grafana/tests/test_notifications.py
