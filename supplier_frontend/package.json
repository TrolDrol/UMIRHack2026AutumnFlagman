{
  "name": "rims-supplier-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --configLoader runner",
    "dev:demo": "vite --host 0.0.0.0 --mode demo --configLoader runner",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "build:demo": "tsc --noEmit && vite build --mode demo --outDir dist-demo --configLoader runner",
    "lint": "eslint .",
    "test": "vitest run --configLoader runner",
    "test:e2e": "npm run build && playwright test",
    "preview": "vite preview --host 0.0.0.0 --configLoader runner"
  },
  "dependencies": {
    "@rims/demo-api": "file:../packages/demo-api",
    "@rims/portal-contracts": "file:../packages/portal-contracts",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  }
}
