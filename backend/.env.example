# Isolated development stack only. Supply a locally chosen password.
RIMS_TEST_PASSWORD=replace-with-local-test-password
# Native tests must name a loopback PostgreSQL database containing 'test'.
RIMS_TEST_POSTGRES=Host=127.0.0.1;Port=55440;Database=rims_test;Username=rims_test;Password=replace-with-local-test-password
# Runtime and EF design time both read this same explicit setting.
ConnectionStrings__Default=Host=127.0.0.1;Port=55440;Database=rims_test;Username=rims_test;Password=replace-with-local-test-password
App__AllowedOrigins__0=http://localhost:5173
App__AllowedOrigins__1=http://localhost:5174
App__AllowedOrigins__2=http://localhost:8080
App__DataProtectionPath=backend/.keys
# Set MetricsEnabled=true on exactly one authoritative metrics source.
App__MetricsEnabled=false
Bootstrap__Username=local-admin
Bootstrap__Password=replace-with-local-admin-password
Demo__Password=replace-with-local-demo-password
